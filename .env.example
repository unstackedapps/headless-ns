# Your NetSuite account ID, like 1234567 or 1234567_SB1. Needed for NetSuite sign-in. A custom MCP server reports its own.
NETSUITE_ACCOUNT_ID=

# Any long random string. Keeps the local session cookie readable after a restart.
SESSION_SECRET=

# netsuite or custom. Leave blank to use the custom server when MCP_TOKEN is set.
# Older files may say opensuitemcp with OSMCP_URL and OSMCP_TOKEN. Those still work as a custom server.
CONNECTOR=

# NetSuite OAuth: Setup > Integration > Manage Integrations > New, with the mcp scope only.
# Redirect URI: https://localhost:5173/api/auth/callback
# Leave the secret blank for a public client.
NETSUITE_MCP_CLIENT_ID=
NETSUITE_MCP_CLIENT_SECRET=
# standard or all
NETSUITE_MCP_SUITE=standard

# Custom MCP server that exposes the ns_* tools. Tested with OpenSuiteMCP (https://app.opensuitemcp.com/api/mcp or self-hosted).
MCP_URL=
MCP_TOKEN=

# Seeds the first saved model when data/models.json does not exist yet.
# An official OpenAI URL becomes the OpenAI provider. Any other URL becomes an OpenAI-compatible host.
# Later models are added in Settings and stored in data/models.json, which stays off git.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
