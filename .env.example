# Account TD3138390 is the default when this is empty.
NETSUITE_ACCOUNT_ID=TD3138390

# Setup > Integration > Manage Integrations > New.
# Authorization Code Grant on. REST Web Services on. Public Client off.
# Redirect URI: https://localhost:5173/api/auth/callback
# Client ID and secret are shown only on the first save.
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=

# Any long random string. Keeps the local session cookie readable after a restart.
SESSION_SECRET=

# opensuitemcp, netsuite, or custom. Leave blank to use OpenSuiteMCP when OSMCP_TOKEN is set.
CONNECTOR=

# OpenSuiteMCP. App Portal → Agent apps → New app → Bearer auth.
OSMCP_URL=https://app.opensuitemcp.com/api/mcp
OSMCP_TOKEN=
OSMCP_NETSUITE_ACCOUNT_ID=TD3138390

# Direct NetSuite MCP. Separate integration record. Scope on the login is mcp, by itself.
# Redirect URI: https://localhost:5173/api/auth/callback
NETSUITE_MCP_CLIENT_ID=
NETSUITE_MCP_CLIENT_SECRET=
# standard or all
NETSUITE_MCP_SUITE=standard

# Mint, or any other MCP host that proxies the NetSuite tools.
MCP_URL=
MCP_TOKEN=

# Seeds the first saved model when data/models.json does not exist yet.
# An official OpenAI URL becomes the OpenAI provider. Any other URL becomes an OpenAI-compatible host.
# Later models are added in Settings and stored in data/models.json, which stays off git.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
